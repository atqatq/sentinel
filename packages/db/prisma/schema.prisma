// ============================================================================
// Sentinel — M1 data foundation schema (typed contract).
//
// This file is the SOURCE OF TRUTH for tables and columns. The initial SQL
// migration (migrations/0001_init/migration.sql) is hand-written to add what
// Prisma cannot express — row-level security, fail-closed tenant policies,
// roles and grants (ADR-0002). packages/db/test/schema.test.js enforces
// schema↔SQL consistency so the two can never drift silently.
//
// Rules encoded here (build spec §8/§9, ingestion spec §4, ADR-0002):
//   - NUMERIC for all money and quantities — never float.
//   - Every tenant-scoped table carries tenant_id as its first column and is
//     covered by a fail-closed RLS policy in the migration.
//   - Idempotency keys are UNIQUE indexes with tenant_id leading (H6):
//       item (tenant, sku) · stock_line (tenant, item, warehouse) ·
//       open_po_line (tenant, po_number, sku) · supplier (tenant, name;
//       external_id unique when present — H7 priority-1) ·
//       delivery_day (tenant, day) · planning_param (tenant, recipe_ref) ·
//       consumption_balance (tenant, sku, period) ·
//       idempotency_key (tenant, kind, key)
//   - fx_rate_pin stores the per-tenant-day pinned usd_to_local rate (C2,
//     Decision 7). The pinning SERVICE and its FX ADR land with the M4 FX
//     fail-safe (M10); the table exists so ingestion can normalize now.
//   - No client-identifying data is ever seeded (D-003): seed tenants are
//     synthetic.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Tenancy ----------------------------------------------------------------

model Tenant {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique
  name         String
  currencyCode String   @map("currency_code") @db.Char(3)
  timezone     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grants            OwnershipGrant[]
  unitCatalog       UnitCatalogEntry[]
  unitAliases       UnitAlias[]
  suppliers         Supplier[]
  items             Item[]
  warehouses        Warehouse[]
  stockLines        StockLine[]
  openPoLines       OpenPoLine[]
  consumption       ConsumptionBalance[]
  deliveryDays      DeliveryDay[]
  planningParams    PlanningParam[]
  categoryOwners    CategoryOwner[]
  ingestFiles       IngestFile[]
  quarantines       QuarantineRecord[]
  dataHealthTasks   DataHealthTask[]
  idempotencyKeys   IdempotencyKey[]
  fxRatePins        FxRatePin[]
  planSeals         PlanSeal[]
  planSealRestatements PlanSealRestatement[]
  tenantRoles       TenantRole[]
  approvalConfigs   ApprovalConfig[]
  approvalLimits    ApprovalLimit[]
  proposals         Proposal[]
  purchaseOrders    PurchaseOrder[]
  supplierChangeHolds SupplierChangeHold[]
  itemCfVersions    ItemCfVersion[]
  ledgerBlocks      LedgerBlock[]
  sessions          UserSession[]

  @@map("tenant")
}

model AppUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  displayName String   @map("display_name")
  isOrigin    Boolean  @default(false) @map("is_origin")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grants            OwnershipGrant[]
  categoryOwners    CategoryOwner[]
  tenantRoles       TenantRole[]     @relation("tenantRoleUser")
  rolesGranted      TenantRole[]     @relation("tenantRoleGranter")
  proposalsRaised   Proposal[]       @relation("proposalsRaised")
  approvalsCast     Approval[]       @relation("approvalsCast")
  purchaseOrdersConverted PurchaseOrder[] @relation("purchaseOrdersConverted")
  supplierHoldsRequested  SupplierChangeHold[] @relation("supplierHoldsRequested")
  supplierHoldsVerified   SupplierChangeHold[] @relation("supplierHoldsVerified")
  cfVersionsRequested     ItemCfVersion[]      @relation("cfVersionsRequested")
  cfVersionsDecided       ItemCfVersion[]      @relation("cfVersionsDecided")
  credential        UserCredential?
  mfaEnrolment      MfaEnrolment?
  sessions          UserSession[]
  loginAttempts     LoginAttempt[]

  @@map("app_user")
}

// A user's accessible tenant set is the union of their grants (build spec §9).
model OwnershipGrant {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  category  String?
  grantedBy String    @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user   AppUser @relation(fields: [userId], references: [id])
  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ownership_grant")
}

// ---- Unit catalog (screen 32 tenant data; feeds resolveUnit's injected catalog)

model UnitCatalogEntry {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String
  name     String
  factor   Decimal? @map("factor") @db.Decimal(18, 8)
  isBase   Boolean @default(false) @map("is_base")

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  aliases UnitAlias[]

  @@unique([tenantId, code])
  @@map("unit_catalog_entry")
}

model UnitAlias {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  catalogEntryId String @map("catalog_entry_id") @db.Uuid
  alias          String

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  catalogEntry UnitCatalogEntry @relation(fields: [catalogEntryId], references: [id])

  @@unique([tenantId, alias])
  @@map("unit_alias")
}

// ---- Master data -------------------------------------------------------------

model Supplier {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  externalId        String? @map("external_id")
  name              String
  isActive          Boolean @default(true) @map("is_active")
  deliveryPeriodDays Int?   @map("delivery_period_days")
  moqValue          Decimal? @map("moq_value") @db.Decimal(18, 6)
  paymentTermsText  String? @map("payment_terms_text")
  paymentTermDays   Int?    @map("payment_term_days")
  currencyCode      String? @map("currency_code") @db.Char(3)
  country           String?
  isBanned          Boolean @default(false) @map("is_banned")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  poLines             OpenPoLine[]
  proposals           Proposal[]
  purchaseOrders      PurchaseOrder[]
  supplierChangeHolds SupplierChangeHold[]

  @@unique([tenantId, name])
  @@index([tenantId, externalId])
  @@map("supplier")
}

model Item {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  sku                   String
  name                  String
  unitCode              String   @map("unit_code")
  conversionFactor      Decimal? @map("conversion_factor") @db.Decimal(18, 8)
  convertedUnit         String?  @map("converted_unit")
  category              String?
  ingredientFamily      String?  @map("ingredient_family")
  recipeRef             String?  @map("recipe_ref")
  brand                 String?
  size                  String?
  caseCount             Int?     @map("case_count")
  price                 Decimal? @db.Decimal(18, 6)
  currencyCode          String?  @map("currency_code") @db.Char(3)
  businessUnit          String?  @map("business_unit")
  shelfLifeDays         Int?     @map("shelf_life_days")
  preferredForRecipeRef Boolean  @default(false) @map("preferred_for_recipe_ref")
  nutritionApproved     Boolean  @default(false) @map("nutrition_approved")
  productionApproved    Boolean  @default(false) @map("production_approved")
  isBanned              Boolean  @default(false) @map("is_banned")
  isInactive            Boolean  @default(false) @map("is_inactive")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  stockLines StockLine[]
  poLines    OpenPoLine[]

  @@unique([tenantId, sku])
  @@map("item")
}

model Warehouse {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  code        String
  name        String
  kind        WarehouseKind
  cbmCapacity Decimal? @map("cbm_capacity") @db.Decimal(18, 6)
  periodCost  Decimal? @map("period_cost") @db.Decimal(18, 6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  stockLines StockLine[]

  @@unique([tenantId, code])
  @@map("warehouse")
}

model StockLine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  warehouseId      String   @map("warehouse_id") @db.Uuid
  quantity         Decimal  @db.Decimal(18, 6)
  unitCode         String   @map("unit_code")
  valueDocument    Decimal  @map("value_document") @db.Decimal(18, 6)
  documentCurrency String   @map("document_currency") @db.Char(3)
  tenantValue      Decimal  @map("tenant_value") @db.Decimal(18, 6)

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, itemId, warehouseId])
  @@map("stock_line")
}

// ---- Operational feeds --------------------------------------------------------

model OpenPoLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  poNumber            String   @map("po_number")
  sku                 String
  itemId              String?  @map("item_id") @db.Uuid
  supplierId          String?  @map("supplier_id") @db.Uuid
  orderedQty          Decimal  @map("ordered_qty") @db.Decimal(18, 6)
  receivedQty         Decimal  @map("received_qty") @db.Decimal(18, 6)
  waitingQty          Decimal  @map("waiting_qty") @db.Decimal(18, 6)
  waitingQtyConverted Decimal? @map("waiting_qty_converted") @db.Decimal(18, 6)
  unitCode            String   @map("unit_code")
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 6)
  currencyCode        String   @map("currency_code") @db.Char(3)
  tenantUnitPrice     Decimal  @map("tenant_unit_price") @db.Decimal(18, 6)
  expectedDelivery    DateTime? @map("expected_delivery") @db.Date
  receiptDates        String?  @map("receipt_dates")
  poCreatedAt         DateTime? @map("po_created_at") @db.Date
  /// Purchase Order Status surface (§14.6c): OPEN | CANCELLED | CLOSED | NULL
  status              String?  @map("status")

  item     Item      @relation(fields: [itemId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, poNumber, sku])
  @@index([tenantId, expectedDelivery])
  @@map("open_po_line")
}

model ConsumptionBalance {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  sku          String
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  startBalance Decimal @map("start_balance") @db.Decimal(18, 6)
  goodsIn      Decimal @map("goods_in") @db.Decimal(18, 6)
  goodsOut     Decimal @map("goods_out") @db.Decimal(18, 6)
  stockChanges Decimal @map("stock_changes") @db.Decimal(18, 6)
  endBalance   Decimal @map("end_balance") @db.Decimal(18, 6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku, periodStart, periodEnd])
  @@map("consumption_balance")
}

model DeliveryDay {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  day          DateTime            @db.Date
  granularity  DeliveryGranularity
  deliveries   Decimal             @db.Decimal(18, 6)
  monthsElapsed Int?               @map("months_elapsed")
  businessUnit String?             @map("business_unit")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, day])
  @@map("delivery_day")
}

model PlanningParam {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  recipeRef String           @map("recipe_ref")
  params    Json             @db.JsonB
  source    PlanningParamSource

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, recipeRef])
  @@map("planning_param")
}

model CategoryOwner {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  category   String
  ownerEmail String? @map("owner_email")
  userId     String? @map("user_id") @db.Uuid

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  user   AppUser? @relation(fields: [userId], references: [id])

  @@unique([tenantId, category])
  @@map("category_owner")
}

// ---- Ingestion control plane ---------------------------------------------------

model IngestFile {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  kind             String
  mode             String
  fileName         String           @map("file_name")
  checksumSha256   String           @map("checksum_sha256")
  byteSize         BigInt           @map("byte_size") @db.BigInt
  status           IngestFileStatus @default(RECEIVED)
  rowCount         Int?             @map("row_count")
  quarantinedCount Int?             @map("quarantined_count")
  receivedAt       DateTime         @default(now()) @map("received_at") @db.Timestamptz(6)
  appliedAt        DateTime?        @map("applied_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  quarantines QuarantineRecord[]

  @@unique([tenantId, kind, checksumSha256])
  @@map("ingest_file")
}

model QuarantineRecord {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ingestFileId String?  @map("ingest_file_id") @db.Uuid
  kind         String
  rowIndex     Int?     @map("row_index")
  field        String?
  rawValue     String?  @map("raw_value")
  reasonCode   String   @map("reason_code")
  detail       String?
  asOf         DateTime @default(now()) @map("as_of") @db.Timestamptz(6)

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  ingestFile IngestFile? @relation(fields: [ingestFileId], references: [id])

  @@index([tenantId, reasonCode])
  @@map("quarantine_record")
}

model DataHealthTask {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  taskType   String              @map("task_type")
  severity   DataHealthSeverity  @default(WARN)
  status     DataHealthStatus    @default(OPEN)
  payload    Json?               @db.JsonB
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?           @map("resolved_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("data_health_task")
}

// H6: the idempotency key IS tenant-scoped by construction — the UNIQUE
// constraint leads with tenant_id, so the same key for two tenants never
// collides and replay within a tenant hits this index.
model IdempotencyKey {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  kind          String
  idemKey       String   @map("idem_key")
  fileChecksum  String?  @map("file_checksum")
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind, idemKey])
  @@map("idempotency_key")
}

// C2 / Decision 7: the pinned per-tenant-day USD→local rate. The pinning
// service and its FX ADR land with the M4 FX fail-safe (M10).
model FxRatePin {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  day        DateTime @db.Date
  usdToLocal Decimal  @map("usd_to_local") @db.Decimal(18, 8)
  pinnedAt   DateTime @default(now()) @map("pinned_at") @db.Timestamptz(6)
  pinnedBy   String?  @map("pinned_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, day])
  @@map("fx_rate_pin")
}

// ---- Engine-live sealed snapshot (M2 unit 3, build spec §11 daily seal) --------
// One seal per tenant per seal_date (H6-style unique); payload carries the
// full computed state; payload_hash = SHA256(canonicalJson(payload)).
// The seal row is revision 1 of the day's version chain; restatements live
// in PlanSealRestatement (M8 §14.16) and never overwrite it.
model PlanSeal {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  sealDate      DateTime @map("seal_date") @db.Date
  engineVersion String   @map("engine_version")
  schemaVersion String   @map("schema_version")
  payload       Json     @db.JsonB
  payloadHash   String   @map("payload_hash")
  sealedAt      DateTime @default(now()) @map("sealed_at") @db.Timestamptz(6)
  sealedBy      String?  @map("sealed_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sealDate])
  @@map("plan_seal")
}

// ---- M8 restatement — the version chain of a sealed tenant-day (§14.16) --------
// Revision >= 2, chained by prevRevision + prevPayloadHash (revision 1 is the
// PlanSeal row itself); UNIQUE (tenant, date, revision) + the fork-guard
// trigger make the chain unforkable; SELECT/INSERT only + the append-only
// trigger — restate again, never un-state. Delta = the deterministic
// as-known-then vs as-known-now summary; reason + restatedBy NOT NULL.
model PlanSealRestatement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  sealDate        DateTime @map("seal_date") @db.Date
  revision        Int
  payload         Json     @db.JsonB
  payloadHash     String   @map("payload_hash")
  prevRevision    Int      @map("prev_revision")
  prevPayloadHash String   @map("prev_payload_hash")
  delta           Json     @db.JsonB
  reason          String
  engineVersion   String   @map("engine_version")
  schemaVersion   String   @map("schema_version")
  restatedBy      String   @map("restated_by")
  restatedAt      DateTime @default(now()) @map("restated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sealDate, revision])
  @@map("plan_seal_restatement")
}

// ---- Enums ---------------------------------------------------------------------

enum WarehouseKind {
  COMPANY
  THIRD_PARTY_LOGISTICS @map("3PL")
  STAGING
  QUARANTINE
  CONSIGNMENT
  VIRTUAL
  INACTIVE

  @@map("warehouse_kind")
}

enum DeliveryGranularity {
  DAILY    @map("daily")
  WEEKLY   @map("weekly")
  MONTHLY  @map("monthly")
  QUARTERLY @map("quarterly")
  YTD      @map("ytd")

  @@map("delivery_granularity")
}

enum PlanningParamSource {
  MANUAL     @map("manual")
  CALCULATED @map("calculated")
  OVERRIDE   @map("override")

  @@map("planning_param_source")
}

enum IngestFileStatus {
  RECEIVED
  QUARANTINED
  APPLIED
  FAILED

  @@map("ingest_file_status")
}

enum DataHealthSeverity {
  INFO
  WARN
  CRITICAL

  @@map("data_health_severity")
}

enum DataHealthStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("data_health_status")
}

// ---- C3 financial controls (0003_controls; gate 5, M3) ----------------------

enum UserRole {
  O
  SCM
  SBR
  BYR
  DTA
  VWR

  @@map("user_role")
}

enum ProposalState {
  OPEN
  APPROVED
  CONVERTED
  DISMISSED

  @@map("proposal_state")
}

enum ApprovalDecision {
  APPROVED
  REJECTED

  @@map("approval_decision")
}

enum SupplierHoldState {
  COOLING_OFF
  APPLIED
  REJECTED

  @@map("supplier_hold_state")
}

enum CfVersionState {
  PENDING
  EFFECTIVE
  REJECTED

  @@map("cf_version_state")
}

// The M7 versioned change ledger (§14.13b): one row per proposed conversion-
// factor change, monotonic version per (tenant, sku). requested_by NULL =
// pipeline-staged (any eligible principal may decide); the item_cf_freeze
// trigger refuses any factor delta outside the resolveCfVersion door.
model ItemCfVersion {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  sku             String
  version         Int
  fromValue       Decimal?        @map("from_value") @db.Decimal(18, 8)
  toValue         Decimal         @map("to_value") @db.Decimal(18, 8)
  state           CfVersionState  @default(PENDING) @map("state")
  requestedBy     String?         @map("requested_by") @db.Uuid
  requestedReason String?         @map("requested_reason")
  decidedBy       String?         @map("decided_by") @db.Uuid
  decisionReason  String?         @map("decision_reason")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt       DateTime?       @map("decided_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  requester AppUser? @relation("cfVersionsRequested", fields: [requestedBy], references: [id])
  decider   AppUser? @relation("cfVersionsDecided", fields: [decidedBy], references: [id])

  @@unique([tenantId, sku, version], map: "item_cf_version_tenant_sku_version_key")
  @@index([tenantId, sku, state], map: "item_cf_version_tenant_sku_state_idx")
  @@index([state], map: "item_cf_version_state_idx")
  @@map("item_cf_version")
}

// H5 log classes — all five write the SAME hash-chained sequence (§16.1:
// class is a field, not a separate store).
enum LedgerClass {
  W
  A
  N
  S
  D

  @@map("ledger_class")
}

enum LedgerOutcome {
  success
  denied
  error

  @@map("ledger_outcome")
}

// §10 roles are regional data: one active role per (tenant, user). Grant and
// revoke authority is Origin-only, enforced at RLS (D-029).
model TenantRole {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      UserRole   @map("role")
  grantedBy String     @map("granted_by") @db.Uuid
  grantedAt DateTime   @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?  @map("revoked_at") @db.Timestamptz(6)

  user     AppUser @relation("tenantRoleUser", fields: [userId], references: [id])
  granter  AppUser @relation("tenantRoleGranter", fields: [grantedBy], references: [id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@map("tenant_role")
}

// The per-tenant dual-control threshold (Origin-amendable, C3).
model ApprovalConfig {
  tenantId             String   @id @map("tenant_id") @db.Uuid
  currencyCode         String   @map("currency_code") @db.Char(3)
  dualThresholdAmount  Decimal  @map("dual_threshold_amount") @db.Decimal(18, 6)
  updatedBy            String?  @map("updated_by") @db.Uuid
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("approval_config")
}

// Value-tiered approval limits by role (C3). maxSingleAmount NULL = unlimited.
model ApprovalLimit {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  role             UserRole @map("role")
  maxSingleAmount  Decimal? @map("max_single_amount") @db.Decimal(18, 6)
  updatedBy        String?  @map("updated_by") @db.Uuid
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, role], map: "approval_limit_tenant_role_key")
  @@map("approval_limit")
}

// OrderProposal(lifecycle) — design-spec screen 5. raised_by is the SoD raiser.
model Proposal {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  code         String
  state        ProposalState @default(OPEN) @map("state")
  raisedBy     String        @map("raised_by") @db.Uuid
  supplierId   String?       @map("supplier_id") @db.Uuid
  currencyCode String        @map("currency_code") @db.Char(3)
  totalAmount  Decimal       @map("total_amount") @db.Decimal(18, 6)
  note         String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  raiser        AppUser          @relation("proposalsRaised", fields: [raisedBy], references: [id])
  supplier      Supplier?        @relation(fields: [supplierId], references: [id])
  lines         ProposalLine[]
  approvals     Approval[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code], map: "proposal_tenant_code_key")
  @@index([tenantId, state], map: "proposal_tenant_state_idx")
  @@map("proposal")
}

model ProposalLine {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  proposalId String  @map("proposal_id") @db.Uuid
  itemId     String? @map("item_id") @db.Uuid
  sku        String
  qty        Decimal @db.Decimal(18, 6)
  unitCode   String  @map("unit_code")
  unitPrice  Decimal @map("unit_price") @db.Decimal(18, 6)

  proposal Proposal @relation(fields: [proposalId], references: [id])

  @@index([proposalId], map: "proposal_line_proposal_id_idx")
  @@map("proposal_line")
}

// Append-only decision rows (the SoD invariant lives at RLS + the state guard).
model Approval {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  proposalId String           @map("proposal_id") @db.Uuid
  approverId String           @map("approver_id") @db.Uuid
  decision   ApprovalDecision @map("decision")
  reason     String
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  proposal Proposal @relation(fields: [proposalId], references: [id])
  approver AppUser  @relation("approvalsCast", fields: [approverId], references: [id])

  @@unique([proposalId, approverId], map: "approval_proposal_approver_key")
  @@map("approval")
}

// The PO Sentinel issues on conversion — document of record, no Precoro write-back.
model PurchaseOrder {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  proposalId   String   @unique @map("proposal_id") @db.Uuid
  supplierId   String   @map("supplier_id") @db.Uuid
  currencyCode String   @map("currency_code") @db.Char(3)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(18, 6)
  convertedBy  String   @map("converted_by") @db.Uuid
  convertedAt  DateTime @default(now()) @map("converted_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  proposal Proposal   @relation(fields: [proposalId], references: [id])
  supplier Supplier   @relation(fields: [supplierId], references: [id])
  converter AppUser   @relation("purchaseOrdersConverted", fields: [convertedBy], references: [id])
  lines    PoLine[]

  @@unique([tenantId, code], map: "purchase_order_tenant_code_key")
  @@map("purchase_order")
}

model PoLine {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  poId      String  @map("po_id") @db.Uuid
  itemId    String? @map("item_id") @db.Uuid
  sku       String
  qty       Decimal @db.Decimal(18, 6)
  unitCode  String  @map("unit_code")
  unitPrice Decimal @map("unit_price") @db.Decimal(18, 6)

  po PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId], map: "po_line_po_id_idx")
  @@map("po_line")
}

// The supplier-identity change freeze (C3): identity/remittance changes are
// staged here and apply only after out-of-band verification.
model SupplierChangeHold {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String            @map("tenant_id") @db.Uuid
  supplierId            String            @map("supplier_id") @db.Uuid
  changedFields         Json              @map("changed_fields")
  state                 SupplierHoldState @default(COOLING_OFF) @map("state")
  requestedBy           String?           @map("requested_by") @db.Uuid
  verificationReference String?           @map("verification_reference")
  verifiedBy            String?           @map("verified_by") @db.Uuid
  requestedAt           DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  resolvedAt            DateTime?         @map("resolved_at") @db.Timestamptz(6)

  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  requester  AppUser? @relation("supplierHoldsRequested", fields: [requestedBy], references: [id])
  verifier   AppUser? @relation("supplierHoldsVerified", fields: [verifiedBy], references: [id])

  @@index([tenantId, supplierId, state], map: "supplier_change_hold_tenant_supplier_idx")
  @@map("supplier_change_hold")
}

// The H5 tamper-evident ledger (0004_ledger, gate 11): ONE hash-chained
// sequence per tenant for every log class (§16.1). hash = HMAC-SHA256(key,
// seq || prevHash || canonicalJson(payload)) computed in the application
// (injected secret-manager key — never stored in the database). prevHash of
// seq 1 is GENESIS (64 zeros). Append-only for EVERY actor including Origin:
// SELECT+INSERT grants only, restrictive RLS policies, and the
// ledger_immutable triggers refuse anything that ever reaches the table.
model LedgerBlock {
  seq           BigInt        @map("seq")
  class         LedgerClass   @map("class")
  tenantId      String        @map("tenant_id") @db.Uuid
  actor         String
  onBehalfOf    String?       @map("on_behalf_of") @db.Uuid
  role          String?
  sourceIp      String?       @map("source_ip")
  sessionId     String?       @map("session_id")
  entity        String
  entityId      String?       @map("entity_id")
  action        String
  outcome       LedgerOutcome
  before        Json?
  after         Json?
  reason        String?
  engineVersion String        @map("engine_version")
  schemaVersion String        @map("schema_version")
  at            DateTime      @db.Timestamptz(6)
  prevHash      String        @map("prev_hash") @db.Char(64)
  hash          String        @db.Char(64)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, seq])
  @@index([tenantId, at(sort: Desc)], map: "ledger_block_tenant_at_idx")
  @@index([tenantId, class], map: "ledger_block_tenant_class_idx")
  @@map("ledger_block")
}

// ---- M11 authentication layer (0005_auth; gate M11, M3) ---------------------
// The PRE-TENANT auth layer: no tenant RLS on these tables by design — the
// session resolution precedes the tenant GUC (the D-031 honest boundary).

model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  passwordSalt String   @map("password_salt")
  algo         String   @default("scrypt")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credential")
}

model MfaEnrolment {
  userId       String    @id @map("user_id") @db.Uuid
  secret       String
  enrolledAt   DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  lastUsedStep BigInt?   @map("last_used_step")

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_enrolment")
}

model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  userId            String    @map("user_id") @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  role              UserRole  @map("role")
  mfaOk             Boolean   @map("mfa_ok")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  terminatedAt      DateTime? @map("terminated_at") @db.Timestamptz(6)
  createdIp         String?   @map("created_ip")

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant  @relation(fields: [tenantId], references: [id])

  @@index([userId], map: "user_session_user_id_idx")
  @@map("user_session")
}

model LoginAttempt {
  id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email  String
  userId String?  @map("user_id") @db.Uuid
  at     DateTime @default(now()) @db.Timestamptz(6)
  outcome String
  ip     String?

  user AppUser? @relation(fields: [userId], references: [id])

  @@map("login_attempt")
}
