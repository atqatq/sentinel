{
  "name": "@sentinel/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Vendored Sentinel UI primitives and SDS theme (A12: owned code, no UI runtime dependency)",
  "type": "module",
  "exports": {
    "./theme": "./theme/tailwind.css",
    "./theme/tokens.css": "./theme/tokens.css",
    "./theme/fonts.css": "./theme/fonts.css",
    "./button": "./src/button.tsx",
    "./status-pill": "./src/status-pill.tsx",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.4.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i theme/build-check.css -o dist/theme-check.css"
  }
}
